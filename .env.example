# Both are required. Generate them with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
FILEDROP_API_KEY=replace-me
FILEDROP_API_SECRET=replace-me

# Where the zips are kept. On a host with a mounted disk, point this at the
# mount (e.g. /data) -- the default lives inside the project, which several
# platforms wipe on redeploy.
# FILEDROP_STORAGE_DIR=/data

# 512 MB default; 0 disables the check.
# FILEDROP_MAX_UPLOAD_BYTES=536870912

# Comma-separated; empty allows any extension.
# FILEDROP_ALLOWED_EXT=.zip

# DJANGO_ALLOWED_HOSTS=filedrop.onrender.com
# DJANGO_DEBUG=0
