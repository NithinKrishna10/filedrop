# filedrop - template. Copy to .env and fill in the two required values.
#
# .env is gitignored; this file is committed, so it must never hold live values.
# Keep it in sync when adding a setting.

# ── required ─────────────────────────────────────────────────────────────────
# Both must be sent on every request as X-Api-Key / X-Api-Secret. Regenerate with
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
FILEDROP_API_KEY=replace-me
FILEDROP_API_SECRET=replace-me

# ── storage backend ──────────────────────────────────────────────────────────
# Set automatically by Vercel when a Blob store is linked to the project. Its
# presence switches the backend to 'blob'; without it the backend is 'disk'.
# BLOB_READ_WRITE_TOKEN=

# Force a backend instead of inferring it from the token above.
# FILEDROP_STORAGE_BACKEND=disk

# Vercel's Blob REST API version header. Only change it if Vercel does.
# FILEDROP_BLOB_API_VERSION=7
# 'private' or 'public'. Must match how the Blob store was created; the API
# refuses a mismatch rather than adapting. Vercel's newer stores are private.
# FILEDROP_BLOB_ACCESS=private

# ── optional ─────────────────────────────────────────────────────────────────
# Where the zips are kept. Default is ./storage, which is fine locally. On a
# host, point this at a mounted disk or a redeploy wipes the files.
# FILEDROP_STORAGE_DIR=/data

# Largest upload accepted, in bytes. Default 512 MB; 0 disables the check.
# The frontend zip is around 40 MB, so the default has plenty of headroom.
# FILEDROP_MAX_UPLOAD_BYTES=536870912

# Comma-separated list of permitted extensions. Empty allows any.
# FILEDROP_ALLOWED_EXT=.zip

# Comma-separated hostnames. '*' is the default because the key/secret pair is
# what protects the service, not the hostname.
# DJANGO_ALLOWED_HOSTS=filedrop.onrender.com

# Unused by this service - no sessions, no signing - but Django wants one set.
# DJANGO_SECRET_KEY=

# Never leave this on where the service is reachable: Django's debug pages
# would show tracebacks and settings to anyone who triggers an error.
# DJANGO_DEBUG=0
